{
    "name": "siz-an/laravel-email-configuration",
    "description": "Publishable Laravel scaffolding: email templates in the database, REST API, and test-send (code lives in your app/)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "email",
        "mail",
        "templates",
        "configuration",
        "api",
        "dynamic"
    ],
    "homepage": "https://github.com/Siz-An/Laravel-email-configuration",
    "support": {
        "issues": "https://github.com/Siz-An/Laravel-email-configuration/issues",
        "source": "https://github.com/Siz-An/Laravel-email-configuration"
    },
    "authors": [
        {
            "name": "Siz-An"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.48|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sizan\\EmailConfiguration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sizan\\EmailConfiguration\\EmailConfigurationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
